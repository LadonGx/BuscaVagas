# Copie para .env na raiz:  cp .env.example .env   (Windows: copy .env.example .env)
# Os valores padrão funcionam para rodar localmente. Tudo escuta só em 127.0.0.1.

# --- Docker (Postgres e Redis) ---------------------------------------------
POSTGRES_USER=buscavagas
POSTGRES_PASSWORD=buscavagas
POSTGRES_DB=buscavagas
# Portas fora do padrão (5432/6379) para não colidir com outros projetos.
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3333
DATABASE_URL=postgresql://buscavagas:buscavagas@127.0.0.1:5433/buscavagas
REDIS_URL=redis://127.0.0.1:6380
WEB_ORIGIN=http://127.0.0.1:5173
# error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Testes ------------------------------------------------------------------
# Banco dos testes de integração. Se ficar comentado, os testes usam o mesmo
# Postgres da DATABASE_URL com "_test" no nome (buscavagas_test). O conteúdo
# desse banco é APAGADO a cada rodada — por isso o nome precisa terminar em _test.
# TEST_DATABASE_URL=postgresql://buscavagas:buscavagas@127.0.0.1:5433/buscavagas_test
