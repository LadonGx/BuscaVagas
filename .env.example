# Copie para .env na raiz:  cp .env.example .env   (Windows: copy .env.example .env)
# Os valores padrão funcionam para rodar localmente. Tudo escuta só em 127.0.0.1.

# --- Docker (Postgres e Redis) ---------------------------------------------
POSTGRES_USER=buscavagas
POSTGRES_PASSWORD=buscavagas
POSTGRES_DB=buscavagas
# Portas fora do padrão (5432/6379) para não colidir com outros projetos.
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3333
DATABASE_URL=postgresql://buscavagas:buscavagas@127.0.0.1:5433/buscavagas
REDIS_URL=redis://127.0.0.1:6380
WEB_ORIGIN=http://127.0.0.1:5173
# error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Descoberta de vagas -----------------------------------------------------
# Fontes ativas, separadas por vírgula (vazio = todas): gupy, greenhouse, lever, ashby
DISCOVERY_SOURCES=
# Termos de busca. Cada termo é uma busca separada nas fontes por termo.
DISCOVERY_TERMS=desenvolvedor,full stack,backend,frontend,node,react
# Varredura automática a cada N horas enquanto a API estiver rodando (0 = desliga).
# A busca manual (POST /api/discovery/scan) funciona sempre.
DISCOVERY_INTERVAL_HOURS=6

# --- Fonte: Gupy (packages/sources/src/gupy/README.md) -------------------------
# Páginas de 100 vagas por termo (1-20).
GUPY_MAX_PAGES=3
# Pausa entre requisições, em ms.
GUPY_REQUEST_DELAY_MS=300

# --- Boards de empresa: Greenhouse, Lever, Ashby -----------------------------
# docs/features/06-company-boards.md. Empresas: slug (final da URL do board) ou
# slug=Nome exibido, separados por vírgula. Lista vazia = fonte inativa.
# Conferir um slug: pnpm --filter @busca-vagas/sources try greenhouse <slug>
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
ASHBY_COMPANIES=
# Pausa entre empresas, em ms (GREENHOUSE_/LEVER_/ASHBY_REQUEST_DELAY_MS).
# GREENHOUSE_REQUEST_DELAY_MS=300

# Filtros dos boards (todos os ATS). Local: br-remote (Brasil + remotas abertas
# + sem local), br (só Brasil + sem local) ou any (sem filtro).
BOARDS_LOCATION=br-remote
# Substituem as listas padrão de palavras do título (deixe comentado para usar
# as padrão — ver packages/sources/src/core/boards/title-filter.ts).
# BOARDS_TITLE_KEYWORDS=developer,engineer,desenvolvedor,software
# BOARDS_TITLE_EXCLUDE=sales engineer,recruiter

# --- Testes ------------------------------------------------------------------
# Banco dos testes de integração. Se ficar comentado, os testes usam o mesmo
# Postgres da DATABASE_URL com "_test" no nome (buscavagas_test). O conteúdo
# desse banco é APAGADO a cada rodada — por isso o nome precisa terminar em _test.
# TEST_DATABASE_URL=postgresql://buscavagas:buscavagas@127.0.0.1:5433/buscavagas_test
