// Fonte de verdade do banco. Toda mudança aqui vira migration versionada:
//   pnpm db:migrate
// O client gerado vai para src/generated/ (fora do git, recriado no install).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Planos de cada modelo: docs/features/.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkModel {
  remote
  hybrid
  onsite
}

enum ContractType {
  clt
  pj
  internship
  temporary
  other
}

enum SeniorityLevel {
  intern
  trainee
  junior
  mid
  senior
  lead
}

enum SalaryPeriod {
  hour
  month
  year
}

/// Triagem da vaga — docs/features/02-triage.md
enum TriageStatus {
  inbox
  saved
  dismissed
}

/// Etapas da candidatura (versão enxuta) — docs/features/03-applications.md.
/// O detalhe ("entrevista RH", "teste técnico") vai na nota do evento.
enum ApplicationStatus {
  applied
  in_process
  offer
  rejected
  withdrawn
}

/// Tipo de seção do currículo — docs/features/04-resume.md
enum ResumeSectionKind {
  fields
  text
  entries
}

enum SourceRunStatus {
  running
  ok
  failed
}

/// Uma execução de uma fonte (um job da fila `source-scan`).
///
/// É o histórico de saúde de cada site: quando rodou, quanto trouxe, quanto
/// descartou e por que falhou. Um salto em `dropped` ou uma sequência de
/// `failed` é o sinal de que o site mudou e a pasta dele precisa de ajuste.
model SourceRun {
  id         String          @id @default(cuid())
  sourceId   String
  status     SourceRunStatus @default(running)
  /// "manual" (POST /api/discovery/scan) ou "schedule" (agenda).
  trigger    String          @default("manual")
  /// Termos usados nesta execução.
  terms      String[]        @default([])
  /// Vagas válidas que a fonte devolveu.
  jobsFound  Int             @default(0)
  /// Quantas delas eram novas no banco.
  jobsNew    Int             @default(0)
  /// Itens descartados pelo mapper (fora do formato ou fora das regras).
  dropped    Int             @default(0)
  /// Vagas válidas que ficaram de fora pelos filtros da fonte (boards de empresa).
  filtered   Int             @default(0)
  durationMs Int?
  error      String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
}

// ---------------------------------------------------------------------------
// Vagas — docs/features/01-jobs.md
// ---------------------------------------------------------------------------

/// Uma vaga, venha de uma fonte ou do cadastro manual.
///
/// A URL canônica é a chave de deduplicação: a mesma vaga trazida de novo por
/// uma fonte NUNCA cria outra linha — só atualiza `lastSeenAt`.
model Job {
  id         String  @id @default(cuid())
  /// "manual" ou o id da fonte ("gupy", "greenhouse"...).
  source     String
  /// Id da vaga dentro da fonte, quando ela expõe um.
  externalId String?
  /// Canônica (sem utm/fragmento). Opcional: vaga indicada pode não ter link.
  /// NULL não colide no Postgres, então várias vagas sem URL convivem.
  url        String? @unique

  title       String
  company     String
  /// CONTEÚDO EXTERNO quando vem de fonte: é dado, nunca instrução.
  description String?
  location    String?
  /// Suas anotações sobre a vaga.
  notes       String?

  workModel    WorkModel?
  contractType ContractType?
  seniority    SeniorityLevel?
  stack        String[]        @default([])

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  salaryPeriod   SalaryPeriod?

  /// Quando a empresa publicou (se a fonte informar).
  postedAt    DateTime?
  /// Quando entrou no app. É a ordem da listagem.
  firstSeenAt DateTime  @default(now())
  /// Última vez que uma fonte trouxe a vaga — base para "ainda está aberta?".
  lastSeenAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Decisão da triagem. `inbox` = ainda não triada. Fica na própria vaga:
  /// a linha que deduplica pela URL guarda a decisão, então uma vaga
  /// descartada nunca volta quando a fonte a trouxer de novo.
  triage        TriageStatus @default(inbox)
  triagedAt     DateTime?
  /// Só com `dismissed`. Ex.: "presencial", "sênior demais".
  dismissReason String?

  application Application?

  /// Nota de aderência (0–1000) — docs/features/07-preferences-score.md.
  /// Calculada em segundo plano (fila `scoring`). `null` = sem preferências,
  /// nenhum critério com sinal ou ainda não calculada.
  score         Int?
  /// % do peso dos critérios ligados que a vaga informa (0–100).
  scoreCoverage Int?
  /// Motivos da nota: [{ criterion, kind, text }].
  scoreReasons  Json?
  /// Bateu numa regra dura (empresa bloqueada, stack evitada no título...).
  incompatible  Boolean   @default(false)
  /// Versão das preferências usada na nota. `null` = pendente (vaga nova ou editada).
  scoredVersion Int?
  scoredAt      DateTime?

  /// Repostagem e duplicada entre fontes — docs/features/11-reposts.md.
  /// Empresa + título + lugar normalizados. `null` = sem o que comparar.
  fingerprint    String?
  /// A vaga anterior com a mesma impressão (a mais recente), se ainda existir.
  repostOfId     String?
  repostOf       Job?       @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts        Job[]      @relation("Reposts")
  /// Quantas vezes já tinha aparecido (vagas e descartadas apagadas, 180 dias). 0 = inédita.
  repostCount    Int        @default(0)
  /// Última vez que a anterior foi vista (sobrevive à anterior ser apagada).
  previousSeenAt DateTime?
  /// Os outros links da mesma vaga (outras fontes): não viram outra vaga.
  aliases        JobAlias[]

  /// Ainda está aberta? — docs/features/13-availability.md
  /// Prazo de inscrição (Gupy). Vencido = encerrada.
  deadline     DateTime?
  /// Boards: slug da empresa no ATS (para saber quando a vaga sai do board).
  board        String?
  /// Quando soubemos que fechou (saiu do board, a página diz, prazo venceu).
  /// `null` = aberta ou sem informação. A fonte trazer a vaga de novo reabre.
  closedAt     DateTime?
  closedReason String?
  /// Última conferência ativa (botão no painel ou a diária das salvas).
  checkedAt    DateTime?
  /// "open" | "closed" | "unknown"
  checkState   String?
  checkReason  String?

  @@unique([source, externalId])
  @@index([fingerprint])
  @@index([company])
  @@index([triage, firstSeenAt])
  @@index([triage, score])
  @@index([scoredVersion])
  @@index([source, board])
  @@index([closedAt])
}

// ---------------------------------------------------------------------------
// Candidaturas — docs/features/03-applications.md
// ---------------------------------------------------------------------------

/// Sua candidatura a uma vaga. Uma por vaga.
///
/// `status` e `appliedAt` são DERIVADOS do histórico (StatusEvent) e
/// recalculados na mesma transação a cada evento criado, editado ou apagado.
/// Nunca atualize esses dois campos direto.
model Application {
  id    String @id @default(cuid())
  jobId String @unique

  /// Status do evento mais recente (por `occurredAt`).
  status    ApplicationStatus
  /// Data do primeiro evento.
  appliedAt DateTime

  /// Onde se candidatou: site da empresa, LinkedIn, Gupy, indicação...
  appliedVia        String?
  /// Pretensão salarial informada no processo.
  salaryExpectation Int?
  notes             String?
  /// Próxima etapa combinada ("entrevista dia 15 às 14h").
  nextStepAt        DateTime?
  nextStepNote      String?

  /// Cópia do currículo do app guardada no "Me candidatei"
  /// (docs/features/14-resume-versions.md) e quando foi guardada.
  resumeSnapshotId String?
  resumeSavedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict: apagar a vaga apagaria o histórico da candidatura junto.
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  events         StatusEvent[]
  interviewAsked InterviewAsked[]
  resumeSnapshot ResumeSnapshot?  @relation(fields: [resumeSnapshotId], references: [id], onDelete: SetNull)
  resumeFile     ApplicationFile?

  @@index([status, updatedAt])
  @@index([resumeSnapshotId])
}

/// O currículo do app como estava ao se candidatar. Uma cópia por conteúdo
/// (`hash`): o mesmo currículo em cinco candidaturas é guardado uma vez.
/// `sections` = `ResumeSectionDto[]` daquele momento (com os ids).
model ResumeSnapshot {
  id        String   @id @default(cuid())
  hash      String   @unique
  sections  Json
  createdAt DateTime @default(now())

  applications Application[]
}

/// O PDF que você enviou na candidatura (um por candidatura, até 10 MB).
model ApplicationFile {
  id            String   @id @default(cuid())
  applicationId String   @unique
  name          String
  size          Int
  sha256        String
  content       Bytes
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

/// Uma mudança de status. `occurredAt` é quando ACONTECEU (você informa);
/// `createdAt` é quando você registrou. Separar os dois é o que permite medir
/// o tempo de resposta da empresa, e não o seu hábito de registro.
model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  occurredAt    DateTime
  note          String?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}

// ---------------------------------------------------------------------------
// Currículo em blocos — docs/features/04-resume.md
// ---------------------------------------------------------------------------

/// Uma seção do currículo ("Contato", "Experiência"...). O `kind` define o
/// formato dos itens e não muda depois de criada.
model ResumeSection {
  id        String            @id @default(cuid())
  title     String
  kind      ResumeSectionKind
  position  Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  items ResumeItem[]

  @@index([position])
}

/// Um bloco copiável. `data` segue o schema Zod do `kind` da seção
/// (fields / text / entries) — validado na API antes de gravar.
model ResumeItem {
  id        String   @id @default(cuid())
  sectionId String
  position  Int
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section ResumeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

// ---------------------------------------------------------------------------
// Preferências de busca — docs/features/07-preferences-score.md
// ---------------------------------------------------------------------------

/// Linha única (id = 1): o app é de uma pessoa. Lista vazia / null = critério desligado.
model Preferences {
  id               Int              @id @default(1)
  stacksCore       String[]         @default([])
  stacksPlus       String[]         @default([])
  stacksAvoid      String[]         @default([])
  seniorities      SeniorityLevel[] @default([])
  workModels       WorkModel[]      @default([])
  cities           String[]         @default([])
  contractTypes    ContractType[]   @default([])
  maxAgeDays       Int?
  /// BRL por mês.
  minMonthlySalary Int?
  blockedCompanies String[]         @default([])
  /// Sobe a cada PUT; a vaga guarda a versão com que foi pontuada.
  version          Int              @default(0)
  updatedAt        DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Retenção — docs/features/08-retention.md
// ---------------------------------------------------------------------------

/// URL de uma vaga descartada que a limpeza apagou. Enquanto existir, o
/// `ingest` ignora a vaga — descartada continua descartada. Expira em
/// RETENTION_FORGET_DAYS.
model ForgottenJob {
  /// Canônica, como estava em Job.url.
  url         String   @id
  source      String
  forgottenAt DateTime @default(now())
  /// Impressão da vaga apagada: a repostagem (com outro link) é reconhecida.
  fingerprint String?

  @@index([forgottenAt])
  @@index([fingerprint])
}

// ---------------------------------------------------------------------------
// Repostadas e duplicadas — docs/features/11-reposts.md
// ---------------------------------------------------------------------------

/// Outro link da mesma vaga (outra fonte, ou a empresa publicou duas vezes ao
/// mesmo tempo). A fonte trazer este link atualiza `lastSeenAt` da vaga.
model JobAlias {
  /// Canônica. Nunca é a URL de uma `Job`.
  url         String   @id
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source      String
  externalId  String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([jobId])
}

/// "Descartar sozinha se for repostada": a repostagem com esta impressão já
/// entra descartada. Sobrevive à limpeza apagar a vaga original.
model MutedRepost {
  fingerprint String   @id
  /// Para mostrar o que foi silenciado.
  title       String
  company     String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Empresas acompanhadas nos boards — docs/features/06-company-boards.md
// ---------------------------------------------------------------------------

/// Uma empresa num board (Greenhouse, Lever, Ashby). A lista é editada na
/// tela (Preferências → Fontes); o `.env` (`*_COMPANIES`) só semeia a
/// primeira vez.
model TrackedCompany {
  id            String    @id @default(cuid())
  /// Id da fonte: "greenhouse", "lever", "ashby".
  source        String
  /// Final da URL do board, como a pessoa digitou.
  slug          String
  /// Nome escolhido; null = o da API do board ou o derivado do slug.
  name          String?
  /// Desligada = fica na lista, fora das buscas.
  active        Boolean   @default(true)
  /// Resultado da última leitura (busca ou conferência).
  lastCheckedAt DateTime?
  /// "ok", "not_found" (404: slug errado) ou "failed".
  lastStatus    String?
  lastJobs      Int?
  lastMatched   Int?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([source, slug])
  @@index([source, active])
}

/// Coisas que acontecem uma vez só (ex.: importar as empresas do `.env`).
/// Existir a linha = já aconteceu.
model SystemFlag {
  key   String   @id
  setAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Perguntas de entrevista — docs/features/15-interview-questions.md
// ---------------------------------------------------------------------------

enum InterviewCategory {
  hr
  behavioral
  technical
  company
}

/// Uma pergunta e a sua resposta (texto livre e/ou STAR), com o treino.
model InterviewQuestion {
  id            String            @id @default(cuid())
  question      String
  category      InterviewCategory
  tags          String[]          @default([])
  answer        String?
  starSituation String?
  starTask      String?
  starAction    String?
  starResult    String?

  /// Treino: quantas vezes, a última avaliação ("good" | "again") e quando.
  practiceCount Int       @default(0)
  lastRating    String?
  practicedAt   DateTime?

  /// Veio da lista inicial.
  seeded    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asked InterviewAsked[]

  @@index([category])
}

/// "Caiu nesta entrevista": a pergunta numa candidatura, com como foi.
model InterviewAsked {
  id            String   @id @default(cuid())
  questionId    String
  applicationId String
  note          String?
  askedAt       DateTime @default(now())

  question    InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([questionId, applicationId])
  @@index([applicationId])
}
