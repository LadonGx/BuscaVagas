{
  "name": "busca-vagas",
  "version": "0.1.0",
  "private": true,
  "description": "Agregador local de vagas de emprego: busca em várias fontes, organiza e acelera candidaturas.",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "pnpm build:packages && pnpm db:generate",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "dev:api": "pnpm build:packages && pnpm db:generate && pnpm --filter @busca-vagas/api dev",
    "dev:web": "pnpm --filter @busca-vagas/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm db:generate && pnpm -r test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @busca-vagas/api prisma:generate",
    "db:migrate": "pnpm --filter @busca-vagas/api prisma:migrate",
    "db:deploy": "pnpm --filter @busca-vagas/api prisma:deploy",
    "db:studio": "pnpm --filter @busca-vagas/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
