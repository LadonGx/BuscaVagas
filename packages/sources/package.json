{
  "name": "@busca-vagas/sources",
  "version": "0.1.0",
  "private": true,
  "description": "Fontes de vagas \u2014 uma pasta por site, todas atr\u00e1s do mesmo contrato JobSource.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "try": "tsx scripts/try-source.ts"
  },
  "dependencies": {
    "@busca-vagas/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15"
  }
}
